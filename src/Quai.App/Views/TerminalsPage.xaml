<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quai.App.Views.TerminalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:ui="using:Quai.App">

    <Grid>
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            AddTabButtonClick="OnAddTabClick"
            AutomationProperties.Name="{l:Str Key=Terminals_Title}"
            SelectionChanged="OnSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="SizeToContent"
            Visibility="{x:Bind ui:UiHelpers.CollapsedIf(ViewModel.IsEmpty), Mode=OneWay}">
            <!-- Actions sur l'onglet sélectionné (aussi dans le menu du clic droit sur l'onglet). -->
            <TabView.TabStripFooter>
                <StackPanel
                    Padding="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        AutomationProperties.Name="{l:Str Key=Terminal_Snippets}"
                        Click="OnSnippetsClick"
                        Style="{StaticResource RowIconButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Terminal_Snippets}">
                        <FontIcon FontSize="14" Glyph="&#xE943;" />
                    </Button>
                    <Button
                        x:Name="SftpHereButton"
                        AutomationProperties.Name="{l:Str Key=Terminal_SftpHere}"
                        Click="OnSftpHereClick"
                        Style="{StaticResource RowIconButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Terminal_SftpHere}">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    </Button>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Aucun terminal ouvert -->
        <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE756;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{l:Str Key=Terminals_EmptyTitle}" />
            <TextBlock
                HorizontalTextAlignment="Center"
                Style="{StaticResource PageHintStyle}"
                Text="{l:Str Key=Terminals_EmptyHint}" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="OnOpenConnectionsClick"
                Content="{l:Str Key=Terminals_OpenConnections}" />
        </StackPanel>
    </Grid>
</UserControl>
