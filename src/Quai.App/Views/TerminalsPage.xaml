<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quai.App.Views.TerminalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:ui="using:Quai.App">

    <Grid>
        <!-- Ctrl+Maj+T hors du terminal (dans le terminal, le moteur natif reçoit les touches : voir NativeTerminal). -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="T"
                Invoked="OnLocalTerminalAccelerator"
                Modifiers="Control,Shift" />
        </Grid.KeyboardAccelerators>

        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            AddTabButtonClick="OnAddTabClick"
            AutomationProperties.Name="{l:Str Key=Terminals_Title}"
            SelectionChanged="OnSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="SizeToContent"
            Visibility="{x:Bind ui:UiHelpers.CollapsedIf(ViewModel.IsEmpty), Mode=OneWay}">
            <!-- Actions sur l'onglet sélectionné (aussi dans le menu du clic droit sur l'onglet). -->
            <TabView.TabStripFooter>
                <StackPanel
                    Padding="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <!-- Terminal local : shell par défaut (réglages) ; la flèche liste les shells installés. -->
                    <SplitButton
                        AutomationProperties.Name="{l:Str Key=Terminals_NewLocal}"
                        Click="OnLocalTerminalClick"
                        Style="{StaticResource TabStripSplitButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Terminals_NewLocalTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE977;" />
                            <TextBlock Text="{l:Str Key=Terminals_NewLocal}" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Opening="OnShellMenuOpening" Placement="BottomEdgeAlignedRight" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button
                        AutomationProperties.Name="{l:Str Key=Terminal_Snippets}"
                        Click="OnSnippetsClick"
                        Style="{StaticResource RowIconButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Terminal_Snippets}">
                        <FontIcon FontSize="14" Glyph="&#xE943;" />
                    </Button>
                    <Button
                        x:Name="SftpHereButton"
                        AutomationProperties.Name="{l:Str Key=Terminal_SftpHere}"
                        Click="OnSftpHereClick"
                        Style="{StaticResource RowIconButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Terminal_SftpHere}">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    </Button>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Aucun terminal ouvert -->
        <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE756;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{l:Str Key=Terminals_EmptyTitle}" />
            <TextBlock
                HorizontalTextAlignment="Center"
                Style="{StaticResource PageHintStyle}"
                Text="{l:Str Key=Terminals_EmptyHint}" />
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="OnEmptyLocalTerminalClick"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{l:Str Key=Terminals_NewLocalTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE977;" />
                        <TextBlock Text="{l:Str Key=Terminals_NewLocal}" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenConnectionsClick" Content="{l:Str Key=Terminals_OpenConnections}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
