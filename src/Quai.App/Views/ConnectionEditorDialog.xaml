<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Quai.App.Views.ConnectionEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="{l:Str Key=Common_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="{l:Str Key=Common_Save}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="440"
            Padding="0,0,16,0"
            Spacing="12">

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <TextBox
                Header="{l:Str Key=Editor_Name}"
                PlaceholderText="{l:Str Key=Editor_NamePlaceholder}"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="{l:Str Key=Editor_Host}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{l:Str Key=Editor_HostPlaceholder}"
                    Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <NumberBox
                    Grid.Column="1"
                    Header="{l:Str Key=Editor_Port}"
                    Maximum="65535"
                    Minimum="1"
                    SpinButtonPlacementMode="Hidden"
                    Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
            </Grid>

            <TextBox
                Header="{l:Str Key=Editor_Username}"
                IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                HorizontalAlignment="Stretch"
                Header="{l:Str Key=Editor_Authentication}"
                SelectedIndex="{x:Bind ViewModel.AuthenticationIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{l:Str Key=Editor_AuthPassword}" />
                <ComboBoxItem Content="{l:Str Key=Editor_AuthKey}" />
            </ComboBox>

            <!-- Authentification par mot de passe -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPasswordAuthentication, Mode=OneWay}">
                <PasswordBox
                    Header="{l:Str Key=Editor_Password}"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                    PlaceholderText="{x:Bind ViewModel.PasswordPlaceholder}" />
                <CheckBox Content="{l:Str Key=Editor_SavePassword}" IsChecked="{x:Bind ViewModel.SavePassword, Mode=TwoWay}" />
            </StackPanel>

            <!-- Authentification par clé privée -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPrivateKeyAuthentication, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="{l:Str Key=Editor_KeyPath}"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="{l:Str Key=Editor_KeyPathPlaceholder}"
                        Text="{x:Bind ViewModel.PrivateKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="OnBrowseKeyClick"
                        Content="{l:Str Key=Common_Browse}" />
                </Grid>
                <PasswordBox
                    Header="{l:Str Key=Editor_Passphrase}"
                    Password="{x:Bind ViewModel.Passphrase, Mode=TwoWay}"
                    PlaceholderText="{x:Bind ViewModel.PassphrasePlaceholder}" />
                <CheckBox Content="{l:Str Key=Editor_SavePassphrase}" IsChecked="{x:Bind ViewModel.SavePassphrase, Mode=TwoWay}" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="FolderBox"
                GotFocus="OnFolderGotFocus"
                Header="{l:Str Key=Editor_Folder}"
                PlaceholderText="{l:Str Key=Editor_FolderPlaceholder}"
                Text="{x:Bind ViewModel.Folder, Mode=TwoWay}"
                TextChanged="OnFolderTextChanged" />

            <TextBox
                Header="{l:Str Key=Editor_Tags}"
                PlaceholderText="{l:Str Key=Editor_TagsPlaceholder}"
                Text="{x:Bind ViewModel.TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                MinHeight="72"
                AcceptsReturn="True"
                Header="{l:Str Key=Editor_Notes}"
                Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
