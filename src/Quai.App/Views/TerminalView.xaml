<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quai.App.Views.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:ui="using:Quai.App">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <!-- Session fermée ou en échec : explication + reconnexion (compte à rebours des tentatives automatiques). -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ShowReconnectBar, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.ReconnectCommand}" Content="{l:Str Key=Terminal_Reconnect}" />
                </InfoBar.ActionButton>
                <Button
                    Margin="0,0,0,12"
                    Command="{x:Bind ViewModel.CancelAutoReconnectCommand}"
                    Content="{l:Str Key=Terminal_CancelAutoReconnect}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.IsAutoReconnecting), Mode=OneWay}" />
            </InfoBar>

            <!-- Connexion rapide établie : proposer de l'ajouter au carnet. -->
            <InfoBar
                CloseButtonClick="OnSaveOfferClosed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ShowSaveOffer, Mode=OneWay}"
                Message="{l:Str Key=QuickConnect_SaveOffer}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="OnSaveToBookClick" Content="{l:Str Key=QuickConnect_Save}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Moteur de terminal (Microsoft.Terminal.Control.dll) absent ou inutilisable. -->
            <InfoBar
                x:Name="EngineError"
                Title="{l:Str Key=Terminal_EngineErrorTitle}"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
        </StackPanel>

        <!--
            Zone du terminal : la fenêtre native du moteur de Windows Terminal est posée exactement sur
            TerminalHost ; la marge autour prend la couleur de fond du terminal.
        -->
        <Grid
            x:Name="TerminalArea"
            Grid.Row="1"
            PointerPressed="OnAreaPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="TerminalHost"
                Margin="{StaticResource TerminalPadding}"
                AutomationProperties.Name="{l:Str Key=Terminal_AutomationName}" />

            <ScrollBar
                x:Name="HistoryScrollBar"
                Grid.Column="1"
                AutomationProperties.Name="{l:Str Key=Terminal_ScrollBarName}"
                IndicatorMode="MouseIndicator"
                IsEnabled="False"
                Orientation="Vertical"
                Scroll="OnScrollBarScroll" />
        </Grid>
    </Grid>
</UserControl>
