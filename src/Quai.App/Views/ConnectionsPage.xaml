<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quai.App.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization">

    <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageSpacing}">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{l:Str Key=Connections_Title}" />
        <TextBlock Style="{StaticResource PageHintStyle}" Text="{l:Str Key=Connections_Placeholder}" />
    </StackPanel>
</UserControl>
