<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Quai.App.Views.SecretPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    CloseButtonText="{l:Str Key=Common_Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="{l:Str Key=Secret_Connect}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="400" Spacing="12">
        <InfoBar
            x:Name="RetryInfo"
            IsClosable="False"
            IsOpen="True"
            Severity="Warning"
            Visibility="Collapsed" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <PasswordBox x:Name="SecretBox" PasswordChanged="OnSecretChanged" />
        <CheckBox
            x:Name="RememberBox"
            Content="{l:Str Key=Secret_Remember}"
            IsChecked="True" />
    </StackPanel>
</ContentDialog>
