<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Quai.App.Views.SnippetPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:m="using:Quai.Core.Models"
    xmlns:ui="using:Quai.App"
    CloseButtonText="{l:Str Key=Common_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonText="{l:Str Key=Snippets_Send}"
    SecondaryButtonText="{l:Str Key=Snippets_Manage}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="480" Spacing="8">
        <!-- Entrée envoie le snippet sélectionné, flèches haut / bas changent de sélection. -->
        <TextBox
            x:Name="FilterBox"
            AutomationProperties.Name="{l:Str Key=Snippets_FilterPlaceholder}"
            IsSpellCheckEnabled="False"
            PlaceholderText="{l:Str Key=Snippets_FilterPlaceholder}"
            PreviewKeyDown="OnFilterPreviewKeyDown"
            Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid MinHeight="200">
            <ListView
                x:Name="SnippetList"
                MaxHeight="320"
                AutomationProperties.Name="{l:Str Key=Snippets_Title}"
                DoubleTapped="OnListDoubleTapped"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Matches}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:Snippet">
                        <StackPanel Padding="0,6" Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CodeCaptionStyle}" Text="{x:Bind FirstLine}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Aucun snippet pour cette connexion. -->
            <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.HasNone)}">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE943;" />
                <TextBlock
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PageHintStyle}"
                    Text="{l:Str Key=Snippets_PickerEmpty}" />
            </StackPanel>

            <!-- Rien ne correspond au filtre. -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource PageHintStyle}"
                Text="{l:Str Key=Snippets_PickerNoMatch}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.HasNoMatch), Mode=OneWay}" />
        </Grid>
    </StackPanel>
</ContentDialog>
