<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quai.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Quai.App">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="900"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{l:Str Key=Settings_Title}" />

            <!-- Apparence -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{l:Str Key=Settings_Appearance}" />
            <tk:SettingsCard Description="{l:Str Key=Settings_ThemeDescription}" Header="{l:Str Key=Settings_Theme}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="180"
                    AutomationProperties.Name="{l:Str Key=Settings_Theme}"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{l:Str Key=Settings_ThemeSystem}" />
                    <ComboBoxItem Content="{l:Str Key=Settings_ThemeLight}" />
                    <ComboBoxItem Content="{l:Str Key=Settings_ThemeDark}" />
                </ComboBox>
            </tk:SettingsCard>

            <!-- Terminal -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{l:Str Key=Settings_Terminal}" />
            <tk:SettingsCard Description="{l:Str Key=Settings_FontDescription}" Header="{l:Str Key=Settings_Font}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D2;" />
                </tk:SettingsCard.HeaderIcon>
                <AutoSuggestBox
                    x:Name="FontBox"
                    Width="240"
                    AutomationProperties.Name="{l:Str Key=Settings_Font}"
                    GotFocus="OnFontGotFocus"
                    Text="{x:Bind ViewModel.TerminalFontFamily, Mode=TwoWay}"
                    TextChanged="OnFontTextChanged" />
            </tk:SettingsCard>
            <tk:SettingsCard Description="{l:Str Key=Settings_FontSizeDescription}" Header="{l:Str Key=Settings_FontSize}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8E9;" />
                </tk:SettingsCard.HeaderIcon>
                <NumberBox
                    Width="160"
                    AutomationProperties.Name="{l:Str Key=Settings_FontSize}"
                    LargeChange="2"
                    Maximum="{x:Bind ViewModel.MaxTerminalFontSize}"
                    Minimum="{x:Bind ViewModel.MinTerminalFontSize}"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.TerminalFontSize, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{l:Str Key=Settings_Preview}">
                <tk:SettingsCard.Description>
                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="{x:Bind ui:UiHelpers.TerminalFont(ViewModel.TerminalFontFamily), Mode=OneWay}"
                        FontSize="{x:Bind ui:UiHelpers.TerminalPreviewFontSize(ViewModel.TerminalFontSize), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{l:Str Key=Settings_PreviewText}"
                        TextWrapping="NoWrap" />
                </tk:SettingsCard.Description>
                <Button Command="{x:Bind ViewModel.ResetTerminalFontCommand}" Content="{l:Str Key=Settings_ResetFont}" />
            </tk:SettingsCard>

            <!-- À propos -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{l:Str Key=Settings_About}" />
            <tk:SettingsCard Description="{l:Str Key=Settings_AboutDescription}" Header="{x:Bind VersionText}">
                <tk:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>
            <tk:SettingsCard Description="{l:Str Key=Settings_UpdatesDescription}" Header="{l:Str Key=Settings_Updates}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="{l:Str Key=Settings_Updates}" IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Description="{x:Bind ViewModel.DataDirectory}" Header="{l:Str Key=Settings_Data}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Click="OnOpenDataFolderClick" Content="{l:Str Key=Settings_OpenDataFolder}" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
