<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quai.App.Views.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:vm="using:Quai.Core.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, recherche, nouveau snippet -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{l:Str Key=Snippets_Title}" />
                <TextBlock Style="{StaticResource PageHintStyle}" Text="{l:Str Key=Snippets_Hint}" />
            </StackPanel>
            <AutoSuggestBox
                Grid.Column="1"
                Width="300"
                VerticalAlignment="Center"
                AutomationProperties.Name="{l:Str Key=Snippets_SearchPlaceholder}"
                PlaceholderText="{l:Str Key=Snippets_SearchPlaceholder}"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.NewCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{l:Str Key=Snippets_New}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="4"
            Style="{StaticResource CardBorderStyle}">
            <Grid>
                <ListView
                    AutomationProperties.Name="{l:Str Key=Snippets_Title}"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SnippetItemViewModel">
                            <Grid
                                Padding="4,10"
                                Background="Transparent"
                                ColumnSpacing="16"
                                DoubleTapped="OnSnippetDoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE943;" />

                                <!-- Raccourci clavier du snippet (dans un terminal). -->
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource ShortcutCaptionStyle}"
                                    Text="{x:Bind ShortcutText}"
                                    Visibility="{x:Bind HasShortcut}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CodeCaptionStyle}" Text="{x:Bind Preview}" />
                                </StackPanel>

                                <Border
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TagChipStyle}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Scope}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        AutomationProperties.Name="{l:Str Key=Common_Edit}"
                                        Command="{x:Bind EditCommand}"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTipService.ToolTip="{l:Str Key=Common_Edit}">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="{l:Str Key=Common_Delete}"
                                        Command="{x:Bind DeleteCommand}"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTipService.ToolTip="{l:Str Key=Common_Delete}">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Aucun snippet -->
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE943;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{l:Str Key=Snippets_EmptyTitle}" />
                    <TextBlock
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource PageHintStyle}"
                        Text="{l:Str Key=Snippets_EmptyHint}" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.NewCommand}"
                        Content="{l:Str Key=Snippets_New}" />
                </StackPanel>

                <!-- Aucun résultat pour la recherche -->
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE721;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{l:Str Key=Snippets_NoResults}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
