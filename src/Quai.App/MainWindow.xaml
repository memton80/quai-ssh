<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Quai.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Quai.App.Localization"
    xmlns:ui="using:Quai.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (zone de glissement de la fenêtre). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    Width="18"
                    Height="18"
                    Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Quai" />
            </StackPanel>
        </Grid>

        <!--
            Nouvelle version publiée sur GitHub : téléchargement, vérification, installation et redémarrage.
            Fermé, le bandeau est retiré de la mise en page : sinon sa marge laisse un écart sous la barre de titre.
        -->
        <InfoBar
            Grid.Row="1"
            Margin="12,0,12,8"
            IsClosable="True"
            IsOpen="{x:Bind Updates.IsOpen, Mode=TwoWay}"
            Message="{x:Bind Updates.Message, Mode=OneWay}"
            Severity="{x:Bind ui:UiHelpers.WarningIf(Updates.HasFailed), Mode=OneWay}"
            Title="{l:Str Key=Update_Title}"
            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Updates.IsOpen), Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    Click="OnUpdateActionClick"
                    Content="{x:Bind Updates.ActionText, Mode=OneWay}"
                    IsEnabled="{x:Bind Updates.IsActionEnabled, Mode=OneWay}" />
            </InfoBar.ActionButton>
            <ProgressBar
                Margin="0,0,0,12"
                AutomationProperties.Name="{l:Str Key=Update_ProgressName}"
                Maximum="100"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Updates.IsDownloading), Mode=OneWay}"
                Value="{x:Bind Updates.Progress, Mode=OneWay}" />
        </InfoBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            ExpandedModeThresholdWidth="1400"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{l:Str Key=Nav_Connections}" Tag="connections">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Str Key=Nav_Terminals}" Tag="terminals">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Str Key=Nav_Sftp}" Tag="sftp">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Str Key=Nav_Snippets}" Tag="snippets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="PageHost" />
        </NavigationView>
    </Grid>
</Window>
