<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Quai.App</RootNamespace>
    <AssemblyName>Quai</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Quai.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>fr-FR</DefaultLanguage>

    <!-- Application non packagée (pas de MSIX), runtime .NET et Windows App SDK embarqués. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!--
      Réduction à la publication (trimming) : le code .NET jamais appelé est retiré des bibliothèques déclarées
      compatibles (runtime .NET, projection C# du SDK Windows, WinUI, SSH.NET, Serilog…). Mode « partial » : les
      bibliothèques non déclarées compatibles (BouncyCastle, Community Toolkit) restent entières, car la
      cryptographie SSH n'est pas exercée par le test de fumée. L'interop WinRT reste entière aussi (voir la cible
      QuaiKeepWinRTInterop).
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Fonctions du runtime inutiles ici : traçage EventSource, propagation d'activité HTTP. -->
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <!--
      Code précompilé (ReadyToRun) : le trimming réécrit le runtime .NET et lui fait perdre le sien, ce qui rallongeait
      le démarrage (compilation à la volée). Les grosses assemblies gardées entières (voir QuaiKeepWinRTInterop) et
      BouncyCastle, utilisé seulement à la connexion SSH, ne sont pas précompilées : elles restent telles que livrées.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll;Microsoft.WinUI.dll;WinRT.Runtime.dll;Microsoft.InteractiveExperiences.Projection.dll;BouncyCastle.Cryptography.dll" />
  </ItemGroup>

  <!-- Permet un simple `dotnet build` sans préciser -r : le RID suit la plateforme. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows App SDK : le métapaquet reste référencé (le Community Toolkit en dépend et tirerait sinon l'ancienne
      version 1.6 monolithique), mais ses composants inutilisés sont neutralisés : une référence directe avec
      ExcludeAssets="all" l'emporte sur la dépendance transitive. Restent Base, Foundation, InteractiveExperiences
      et WinUI. Neutralisés : IA, ML (onnxruntime, DirectML), recherche sémantique, widgets, DWriteCore (~65 Mo
      jamais chargés), et le paquet Runtime, qui ne sert qu'au mode dépendant du framework.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    Terminal : moteur natif de Windows Terminal (Microsoft.Terminal.Control.dll, rendu DirectWrite / Direct3D).
    Le paquet contient aussi une enveloppe WPF : il est seulement téléchargé (PackageDownload), jamais référencé,
    sinon il ferait embarquer WPF ; seule la DLL native de l'architecture publiée est copiée à côté de Quai.exe.
  -->
  <ItemGroup>
    <PackageDownload Include="CI.Microsoft.Terminal.Wpf" Version="[$(TerminalControlPackageVersion)]" />
  </ItemGroup>
  <PropertyGroup>
    <TerminalControlDll>$(NuGetPackageRoot)ci.microsoft.terminal.wpf\$(TerminalControlPackageVersion)\runtimes\$(RuntimeIdentifier)\native\Microsoft.Terminal.Control.dll</TerminalControlDll>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(TerminalControlDll)" Link="Microsoft.Terminal.Control.dll" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CheckTerminalControlDll" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TerminalControlDll)')" Text="Moteur de terminal introuvable : $(TerminalControlDll)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Quai.Core\Quai.Core.csproj" />
  </ItemGroup>

  <!--
    Allègement de la publication : rien de ce qui suit n'est utilisé par Quai.
    - WebView2 (dépendance de WinUI) : la projection C# reste pour la compilation de WinUI, mais ni la DLL native
      Microsoft.Web.WebView2.Core.dll ni WebView2Loader.dll ne sont copiées (aucun contrôle WebView2 dans Quai,
      et c'est un interdit du projet). Sans le paquet Runtime du Windows App SDK, la projection doit être demandée
      explicitement (le paquet WebView2 la choisissait d'après ce paquet).
    - Langues de WinUI : seuls le français et l'anglais (repli) sont gardés, l'interface est forcée en fr-FR.
    - Carte (map.html) de WinUI : sert au contrôle MapControl, absent de Quai.
    - Outils de diagnostic du runtime .NET (débogueur, analyse de vidages) : retirés à la publication seulement,
      pour garder le débogage de Visual Studio sur la sortie de build.
  -->
  <PropertyGroup>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
    <WebView2EnableCsWinRTProjectionExcludeCoreRef>true</WebView2EnableCsWinRTProjectionExcludeCoreRef>
  </PropertyGroup>

  <!--
    Interop WinRT gardée entière au trimming : les view-models et collections de Quai.Core (sans générateur CsWinRT,
    Quai.Core ne connaît pas Windows) passent à WinUI par des interfaces COM que CsWinRT construit par réflexion à
    l'exécution ; réduites, ces assemblies perdent les types qu'il cherche (plantage dès le carnet de connexions).
  -->
  <Target Name="QuaiKeepWinRTInterop" BeforeTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'WinRT.Runtime'
                                        or '%(Filename)' == 'Microsoft.Windows.SDK.NET'
                                        or '%(Filename)' == 'Microsoft.WinUI'
                                        or $([System.String]::Copy('%(Filename)').EndsWith('.Projection'))">
        <TrimMode>copy</TrimMode>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

  <Target Name="QuaiExcludeWindowsAppSdkPayload"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
          DependsOnTargets="GetWindowsAppSDKNativePlatform">
    <PropertyGroup>
      <_QuaiWasdkNative>runtimes-framework\win-$(NativePlatform)\native</_QuaiWasdkNative>
    </PropertyGroup>
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded Include="%(WindowsAppSdkComponentPackages.Identity)$(_QuaiWasdkNative)\**\*.mui"
                                           Exclude="%(WindowsAppSdkComponentPackages.Identity)$(_QuaiWasdkNative)\fr-FR\**;%(WindowsAppSdkComponentPackages.Identity)$(_QuaiWasdkNative)\en-US\**;%(WindowsAppSdkComponentPackages.Identity)$(_QuaiWasdkNative)\en-us\**" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="%(WindowsAppSdkComponentPackages.Identity)$(_QuaiWasdkNative)\**\map.html" />
    </ItemGroup>
  </Target>

  <Target Name="QuaiExcludeWebView2Loader" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'WebView2Loader.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="QuaiExcludeRuntimeDiagnostics" AfterTargets="ResolveRuntimePackAssets" Condition="'$(_IsPublishing)' == 'true'">
    <ItemGroup>
      <_QuaiRuntimeDiagnostics Include="@(RuntimePackAsset)"
                               Condition="'%(Filename)%(Extension)' == 'createdump.exe'
                                          or '%(Filename)%(Extension)' == 'mscordbi.dll'
                                          or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))
                                          or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))" />
      <!-- ResolveRuntimePackAssets les a déjà ajoutés à la copie locale : retirés des deux listes. -->
      <RuntimePackAsset Remove="@(_QuaiRuntimeDiagnostics)" />
      <ReferenceCopyLocalPaths Remove="@(_QuaiRuntimeDiagnostics)" />
    </ItemGroup>
  </Target>

  <!-- Les fichiers d'Assets sont copiés tels quels à côté de l'exécutable (icône, licences). -->
  <PropertyGroup>
    <EnableDefaultAssets>false</EnableDefaultAssets>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
