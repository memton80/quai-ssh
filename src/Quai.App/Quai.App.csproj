<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Quai.App</RootNamespace>
    <AssemblyName>Quai</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Quai.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>fr-FR</DefaultLanguage>

    <!-- Application non packagée (pas de MSIX), runtime .NET et Windows App SDK embarqués. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- Permet un simple `dotnet build` sans préciser -r : le RID suit la plateforme. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    Terminal : moteur natif de Windows Terminal (Microsoft.Terminal.Control.dll, rendu DirectWrite / Direct3D).
    Le paquet contient aussi une enveloppe WPF : il est seulement téléchargé (PackageDownload), jamais référencé,
    sinon il ferait embarquer WPF ; seule la DLL native de l'architecture publiée est copiée à côté de Quai.exe.
  -->
  <ItemGroup>
    <PackageDownload Include="CI.Microsoft.Terminal.Wpf" Version="[$(TerminalControlPackageVersion)]" />
  </ItemGroup>
  <PropertyGroup>
    <TerminalControlDll>$(NuGetPackageRoot)ci.microsoft.terminal.wpf\$(TerminalControlPackageVersion)\runtimes\$(RuntimeIdentifier)\native\Microsoft.Terminal.Control.dll</TerminalControlDll>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(TerminalControlDll)" Link="Microsoft.Terminal.Control.dll" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CheckTerminalControlDll" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TerminalControlDll)')" Text="Moteur de terminal introuvable : $(TerminalControlDll)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Quai.Core\Quai.Core.csproj" />
  </ItemGroup>

  <!-- Les fichiers d'Assets sont copiés tels quels à côté de l'exécutable (icône, licences). -->
  <PropertyGroup>
    <EnableDefaultAssets>false</EnableDefaultAssets>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
