<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Quai.Core</RootNamespace>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <!-- Analyse de compatibilité trimming / AOT à la compilation : l'application est réduite à la publication. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="Porta.Pty" />
    <PackageReference Include="Semver" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quai.Core.Tests" />
  </ItemGroup>

</Project>
